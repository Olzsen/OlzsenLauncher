{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearth Launcher",
  "version": "0.1.0",
  "identifier": "dev.hearth.launcher",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Hearth Launcher",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A cozy Minecraft launcher prototype"
  }
}

